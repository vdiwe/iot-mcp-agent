# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic          # anthropic | openai | gemini

# Anthropic (default) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...    # required when LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5     # claude-sonnet-4-5 | claude-opus-4-0 | etc.

# OpenAI — https://platform.openai.com
# OPENAI_API_KEY=sk-...         # required when LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o

# Google Gemini — https://aistudio.google.com
# GEMINI_API_KEY=AIza...        # required when LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash

# ── IoT Platform ──────────────────────────────────────────────────────────────
PLATFORM=simulate               # simulate | cumulocity | aws_iot | azure_iot

# Cumulocity credentials (only needed if PLATFORM=cumulocity)
C8Y_BASE_URL=https://your-tenant.cumulocity.com
C8Y_USERNAME=your@email.com
C8Y_PASSWORD= <Cumulocity Password>  # e.g., MySecretPassword123
C8Y_TENANT_ID= <Cumulocity Tenant ID>  # e.g., t12345678

# ── Agent Settings ────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=20
AGENT_CHECK_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
